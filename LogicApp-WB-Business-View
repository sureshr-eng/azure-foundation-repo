// Capture the workbook parameter as a dynamic array
let StatusFilter = dynamic([{Status}]);

// Base dataset
let Base =
    LogicAppWorkflowRuntime
    | order by TimeGenerated desc
    | where TrackedProperties != ""  
    | project
        InterfaceName   = parse_json(TrackedProperties).interfaceName,
        ComponentName   = parse_json(TrackedProperties).componentName,
        TrackingId      = parse_json(TrackedProperties).trackingId,
        TransactionId   = parse_json(TrackedProperties).transactionId,
        TransactionType = parse_json(TrackedProperties).transactionType,
        ExecutionId     = parse_json(TrackedProperties).executionId,
        ExecutionStage  = parse_json(TrackedProperties).executionStage,
        Source          = parse_json(TrackedProperties).source,
        Target          = parse_json(TrackedProperties).target,
        Status          = parse_json(TrackedProperties).status,
        StartTime       = parse_json(TrackedProperties).startTime,
        EndTime         = parse_json(TrackedProperties).endTime,
        TimeGenerated        
    | where TrackingId != "" and ExecutionStage!="" and TransactionId !="" and TimeGenerated {TimeRange};

// Publisher summary
let Publisher =
    Base
    | where ExecutionStage =~ "Publisher"
    | summarize PublisherStatuses = make_set(Status),Source = any(Source) by tostring(TrackingId), tolong(TransactionId),tostring(TransactionType),tostring(InterfaceName);

// Subscriber summary
let Subscriber =
    Base
    | where ExecutionStage =~ "Subscriber"
    | summarize SubscriberStatuses = make_set(Status),Target = any(Target) by tostring(TrackingId),tolong(TransactionId),tostring(TransactionType), tostring(InterfaceName);

// Join and apply business rules
Publisher
| join kind=fullouter Subscriber on TrackingId, InterfaceName,TransactionId,TransactionType
| extend BusinessStatus =
    case(
        set_has_element(PublisherStatuses, "Failed") or set_has_element(SubscriberStatuses, "Failed"), "Failed",
        set_has_element(PublisherStatuses, "Succeeded") and set_has_element(SubscriberStatuses, "Succeeded"), "Succeeded",
        set_has_element(PublisherStatuses, "Received") or set_has_element(SubscriberStatuses, "Received"), "InProgress",
        "Unknown"
    )
| project InterfaceName,TransactionId,TrackingId,TransactionType,BusinessStatus,Source,Target, PublisherStatuses, SubscriberStatuses
| where TrackingId !=""
| where isempty('{InterfaceName}') or InterfaceName == '{InterfaceName}'
| where isempty('{TransactionId}') or TransactionId == '{TransactionId}'
| where array_length(StatusFilter)==0 or BusinessStatus in (StatusFilter)
| where TrackingId !=""
| summarize by tostring(InterfaceName),tostring(TransactionId),tostring(BusinessStatus),tostring(TransactionType),tostring(Source),
tostring(Target),tostring(TrackingId),tostring(PublisherStatuses),tostring(SubscriberStatuses)


